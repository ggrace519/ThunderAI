{
  "name": "thunderai-dev-tooling",
  "private": true,
  "description": "Development tooling only (the test suites). Never packaged: no shipped code may import anything from node_modules.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "npm run test:upstream && npm run test:fork",
    "test:upstream": "node --test --test-timeout=120000 \"tests/**/*.test.mjs\" \"tests/**/*.dom.mjs\"",
    "test:dom": "node --test --test-timeout=120000 \"tests/**/*.dom.mjs\"",
    "test:fork": "vitest run",
    "test:fork:watch": "vitest",
    "coverage": "vitest run --coverage",
    "changelog": "node .github/scripts/changelog-sync.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.1",
    "vitest": "4.1.12"
  }
}
